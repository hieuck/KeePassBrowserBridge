<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net40</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>KeePassBrowserBridge</RootNamespace>
    <AssemblyName>KeePassBrowserBridge</AssemblyName>
    <KeePassReferencePath Condition=" '$(KeePassReferencePath)' == '' ">..\..\..</KeePassReferencePath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="KeePass">
      <HintPath>$(KeePassReferencePath)\KeePass.exe</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Bridge\BridgeAuthentication.cs" />
    <Compile Include="Bridge\BridgeClock.cs" />
    <Compile Include="Bridge\BridgeJsonSerializer.cs" />
    <Compile Include="Bridge\BridgeRequestHandler.cs" />
    <Compile Include="Bridge\BridgeSettings.cs" />
    <Compile Include="Bridge\CredentialMutationService.cs" />
    <Compile Include="Bridge\CredentialQueryService.cs" />
    <Compile Include="Bridge\EntryUrlMatcher.cs" />
    <Compile Include="Bridge\LoopbackBridgeServer.cs" />
    <Compile Include="Bridge\PairingService.cs" />
    <Compile Include="Bridge\ProtocolModels.cs" />
    <Compile Include="Bridge\ProtocolValidator.cs" />
    <Compile Include="Bridge\TrustedClientStore.cs" />
    <Compile Include="Bridge\TotpGenerator.cs" />
    <Compile Include="Bridge\UrlMatcher.cs" />
    <Compile Include="KeePassBrowserBridgeExt.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
</Project>
