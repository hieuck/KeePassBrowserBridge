{
  "name": "keepass-browser-bridge",
  "version": "2.1.0",
  "description": "KeePass browser integration extension",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ci": "vitest run --coverage --reporter=verbose",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:msedge": "playwright test --project=msedge",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1",
    "lint": "eslint extension/ tests/ --ext .js,.ts,.mjs",
    "dev": "node tests/e2e/server.mjs",
    "build": "npm run build:release",
    "build:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1",
    "build:extension": "npm run build:release",
    "build:plugin": "npm run build:release",
    "build:vue": "cd extension && npx vite build",
    "build:components": "cd extension && npx vite build --config vite.web-components.config.js",
    "build:all": "npm run build:vue && npm run build:components",
    "size": "node scripts/check-bundle-size.mjs",
    "test:mutation": "npx stryker run",
    "test:mutation:quick": "npx stryker run --mutate \"extension/shared/*.js\" --mutate \"!extension/shared/design-tokens.js\" --mutate \"!extension/shared/storage.js\"",
    "ci": "npm run test && npm run test:coverage && npm run test:e2e:chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "prettier": "^3.9.4",
    "vite": "^8.1.3",
    "vitest": "^4.1.9",
    "vue": "^3.5.39"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.2.6"
  },
  "overrides": {
    "qs": "^6.15.3"
  }
}
