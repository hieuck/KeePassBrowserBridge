{
  "name": "keepass-browser-bridge",
  "version": "2.0.0",
  "description": "KeePass browser integration extension",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1",
    "lint": "eslint extension/ tests/ --ext .js,.ts,.mjs",
    "dev": "node tests/e2e/server.mjs",
    "build": "npm run build:release",
    "build:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1",
    "build:extension": "npm run build:release",
    "build:plugin": "npm run build:release",
    "build:vue": "cd extension && npx vite build",
    "build:components": "cd extension && npx vite build --config vite.web-components.config.js",
    "build:all": "npm run build:vue && npm run build:components",
    "ci": "npm run test && npm run test:coverage && npm run test:e2e:chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.40.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^9.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "prettier": "^3.0.0",
    "vite": "^5.4.21",
    "vitest": "^1.0.0",
    "vue": "^3.5.38"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.2.6"
  }
}
