{
  "manifest_version": 3,
  "name": "KeePass Browser Bridge",
  "description": "Fill browser logins from KeePass through a local bridge plugin.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "KeePass Browser Bridge"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ]
}
