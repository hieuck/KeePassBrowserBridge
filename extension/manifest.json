{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "description": "__MSG_appDescription__",
  "version": "2.1.0",
  "default_locale": "en",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; frame-ancestors 'none'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "KeePass Browser Bridge"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open KeePass popup"
    },
    "fill-credentials": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Fill credentials on current page"
    },
    "fill-totp": {
      "suggested_key": {
        "default": "Ctrl+Shift+T",
        "mac": "Command+Shift+T"
      },
      "description": "Fill TOTP on current page"
    },
    "lock-database": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Lock KeePass database"
    },
    "show-popup": {
      "description": "Open KeePass popup (alternative)"
    },
    "generate-password": {
      "description": "Generate and copy a strong password"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "compat.js",
        "httpAuth.js",
        "customFields.js",
        "dist/contentScript.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "clipboardWrite",
    "contextMenus",
    "notifications",
    "webRequest",
    "webRequestAuthProvider",
    "webAuthenticationProxy"
  ],
  "optional_permissions": [
    "webNavigation"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [{
    "resources": [
      "src/components/Picker.web.js",
      "src/components/Prompt.web.js",
      "icons.js"
    ],
    "matches": ["http://*/*", "https://*/*"]
  }]
}
