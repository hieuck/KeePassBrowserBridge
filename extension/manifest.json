{
  "manifest_version": 3,
  "name": "KeePass Browser Bridge",
  "description": "Fill browser logins from KeePass through a local bridge plugin.",
  "version": "2.0.0",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "KeePass Browser Bridge"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "compat.js",
        "httpAuth.js",
        "customFields.js",
        "contentScript.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "clipboardWrite",
    "contextMenus",
    "notifications",
    "webRequest",
    "webRequestAuthProvider",
    "webAuthenticationProxy"
  ],
  "optional_permissions": [
    "webNavigation"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ]
}
