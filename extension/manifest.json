{
  "manifest_version": 3,
  "name": "KeePass Browser Bridge",
  "description": "Fill browser logins from KeePass through a local bridge plugin.",
  "version": "0.9.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "KeePass Browser Bridge"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "compat.js",
        "httpAuth.js",
        "customFields.js",
        "contentScript.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "clipboardWrite",
    "contextMenus",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ]
}
