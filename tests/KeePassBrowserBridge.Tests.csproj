<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <BaseOutputPath Condition="'$(BaseOutputPath)' == ''">$(TEMP)\KeePassBrowserBridgeTests\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath Condition="'$(BaseIntermediateOutputPath)' == ''">$(TEMP)\KeePassBrowserBridgeTests\obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="KeePass">
      <HintPath>..\..\..\KeePass.exe</HintPath>
    </Reference>
    <Compile Include="..\src\Bridge\BridgeAuthentication.cs" Link="BridgeAuthentication.cs" />
    <Compile Include="..\src\Bridge\BridgeClock.cs" Link="BridgeClock.cs" />
    <Compile Include="..\src\Bridge\BridgeJsonSerializer.cs" Link="BridgeJsonSerializer.cs" />
    <Compile Include="..\src\Bridge\BridgeRequestHandler.cs" Link="BridgeRequestHandler.cs" />
    <Compile Include="..\src\Bridge\BridgeSettings.cs" Link="BridgeSettings.cs" />
    <Compile Include="..\src\Bridge\LoopbackBridgeServer.cs" Link="LoopbackBridgeServer.cs" />
    <Compile Include="..\src\Bridge\ProtocolModels.cs" Link="ProtocolModels.cs" />
    <Compile Include="..\src\Bridge\ProtocolValidator.cs" Link="ProtocolValidator.cs" />
    <Compile Include="..\src\Bridge\CredentialMutationService.cs" Link="CredentialMutationService.cs" />
    <Compile Include="..\src\Bridge\CredentialQueryService.cs" Link="CredentialQueryService.cs" />
    <Compile Include="..\src\Bridge\PairingService.cs" Link="PairingService.cs" />
    <Compile Include="..\src\Bridge\TrustedClientStore.cs" Link="TrustedClientStore.cs" />
    <Compile Include="..\src\Bridge\UrlMatcher.cs" Link="UrlMatcher.cs" />
  </ItemGroup>
</Project>
